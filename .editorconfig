# EditorConfig — https://editorconfig.org
# Editor defaults for new edits only; no existing file is reformatted by this.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.bpmn]
indent_size = 2

[*.svg]
indent_size = 2
