    <bpmn2:textAnnotation id="TextAnnotation_0ep49bv">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">p.a. + seitlich (Empf. 6.3)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>p.a. + seitlich (Empf. 6.3)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0da80wq">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">BB, Elektrolyte, Leber/Niere, Gerinnung  (6.2)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>BB, Elektrolyte, Leber/Niere, Gerinnung  (6.2)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1o4lb3n">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Raucher-/Berufsanamnese, ECOG (EK 6.1)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Raucher-/Berufsanamnese, ECOG (EK 6.1)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0e6lg4x">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Voraufnahmen-Vergleich (6.28) und Malignitäts-Wahrscheinlichkeit (6.29/6.30)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Voraufnahmen-Vergleich (6.28) und Malignitäts-Wahrscheinlichkeit (6.29/6.30)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1uhqyxk">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (6.37).</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (6.37).</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_1ysqajk" associationDirection="None" sourceRef="Gateway_1volm8e" targetRef="TextAnnotation_1uhqyxk" />
    <bpmn2:association id="Association_0j7uxcd" associationDirection="None" sourceRef="TextAnnotation_1uhqyxk" targetRef="Gateway_0zozacf" />
    <bpmn2:textAnnotation id="TextAnnotation_0pdazv6">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Auch bei unauffälligem Röntgen: bei klinischem Hochrisiko (z. B. Hämoptyse, &gt; 40 J., Raucher/COPD) weiterführende Diagnostik (CT-Thorax / Bronchoskopie) veranlassen. Röntgen-Sensitivität nur ~77–80 % (S3-LL 6.1.2 / 6.3.1).</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Auch bei unauffälligem Röntgen: bei klinischem Hochrisiko (z. B. Hämoptyse, &gt; 40 J., Raucher/COPD) weiterführende Diagnostik (CT-Thorax / Bronchoskopie) veranlassen. Röntgen-Sensitivität nur ~77–80 % (S3-LL 6.1.2 / 6.3.1).</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Association_1qg0mq7" associationDirection="None" sourceRef="Gateway_1rj76cy" targetRef="TextAnnotation_0pdazv6" />
    <bpmn2:association id="Association_1lg2aib" associationDirection="None" sourceRef="Activity_1snw1y2" targetRef="TextAnnotation_0e6lg4x" />
    <bpmn2:association id="Association_0kkf8sl" associationDirection="None" sourceRef="Activity_1p2a6bi" targetRef="TextAnnotation_1o4lb3n" />
  </bpmn2:collaboration>
