    <bpmn2:textAnnotation id="TextAnnotation_0ep49bv">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">posterior-anterior + seitlich (Empf. 6.3)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>posterior-anterior + seitlich (Empf. 6.3)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0da80wq">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">BB, Elektrolyte, Leber/Niere, Gerinnung  (6.2)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>BB, Elektrolyte, Leber/Niere, Gerinnung  (6.2)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1o4lb3n">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Raucher-/Berufsanamnese, ECOG (EK 6.1)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Raucher-/Berufsanamnese, ECOG (EK 6.1)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0e6lg4x">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Voraufnahmen-Vergleich (Empf. 6.28) und Malignitäts-Wahrscheinlichkeit (Empf. 6.29/6.30)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Voraufnahmen-Vergleich (Empf. 6.28) und Malignitäts-Wahrscheinlichkeit (Empf. 6.29/6.30)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1uhqyxk">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (Empf. 6.37).</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (Empf. 6.37).</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0pdazv6">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Auch bei unauffälligem Röntgen: bei klinischem Hochrisiko (z. B. Hämoptyse, &gt; 40 J., Raucher/COPD) weiterführende Diagnostik (CT-Thorax / Bronchoskopie) veranlassen. Röntgen-Sensitivität nur ~77–80 % (S3-LL 6.1.2 / 6.3.1).</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Auch bei unauffälligem Röntgen: bei klinischem Hochrisiko (z. B. Hämoptyse, &gt; 40 J., Raucher/COPD) weiterführende Diagnostik (CT-Thorax / Bronchoskopie) veranlassen. Röntgen-Sensitivität nur ~77–80 % (S3-LL 6.1.2 / 6.3.1).</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0qlv8ad">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">CT nur bei Verdacht und absehbarer Therapieoption (EK 6.4)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>CT nur bei Verdacht und absehbarer Therapieoption (EK 6.4)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0qkhxne">
      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="en">Keine tumorgerichtete Abklärung:  weiterhin symptomatische/supportive Versorgung beim Hausarzt (EK 6.31)</i18n:translation>
      </bpmn2:extensionElements>
      <bpmn2:text>Keine tumorgerichtete Abklärung:  weiterhin symptomatische/supportive Versorgung beim Hausarzt (EK 6.31)</bpmn2:text>
    </bpmn2:textAnnotation>
