    <bpmn2:textAnnotation id="TextAnnotation_11xb7dz">
      <bpmn2:text>Krankheitsvorgeschichte, Begleiterkrankungen, Familienanamnese, Rauchgewohnheiten, Arbeitsanamnese</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1mgjw86">
      <bpmn2:text>physikalische Untersuchung: internistische Untersuchung, Beurteilung der horakalen Organe und verschiedenen Lymphknotenstationen</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0c838gw">
      <bpmn2:text>Basislaboruntersuchungen: Blutbild inkl. Differenzialblutbild, Elektrolyte, Leber- und Nierenparameter, Gerinnungswerte</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:group id="Group_1t782x5" categoryValueRef="CategoryValue_0hz7hrd" />
    <bpmn2:textAnnotation id="TextAnnotation_1m4dzsh">
      <bpmn2:text>S3-Leitlinie v5.1: Empf. 6.1 (EK)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0vagwt4">
      <bpmn2:text>S3-Leitlinie v5.1: Empf. 6.1 (EK), Hintergrundtext S. 112 f.</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1scnuty">
      <bpmn2:text>S3-Leitlinie v5.1: Empf. 6.3 (2),</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1gh4jz1">
      <bpmn2:text>S3-Leitlinie v5.1: Empf. 6.4 (EK), Hintergrundtext S. 119</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_03ua54w">
      <bpmn2:text>mglw. Entscheidungsgateway notwendig</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0dhhcdv">
      <bpmn2:text>mglw. Gateway einsetzen (Leitlinie S. 117, Empf. 6.4 (EK), S. 119)</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_0obfogk">
      <bpmn2:text>S3-Leitlinie v5.1: Hintergrundtext S. 117</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1odn5ep">
      <bpmn2:text>S3-Leitlinie v5.1: Hintergrundtext S. 117</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1d8ek17">
      <bpmn2:text>S3-Leitlinie v5.1: Hintergrundtext S. 119</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_1t49oqj">
      <bpmn2:text>Ergänzend zum CT-Staging</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:textAnnotation id="TextAnnotation_066pmcf">
      <bpmn2:text>Ergänzend zum CT-Staging, Alternative zu TTUS</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:group id="Group_103xagx" categoryValueRef="CategoryValue_1xu3ynm" />
    <bpmn2:textAnnotation id="TextAnnotation_1logq38">
