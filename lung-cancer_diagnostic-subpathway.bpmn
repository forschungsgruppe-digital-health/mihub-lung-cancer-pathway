    <bpmn:messageFlow id="Flow_0ro9ef6" sourceRef="Participant_0o5ya8t" targetRef="Event_18vre97" />
    <bpmn:textAnnotation id="TextAnnotation_0xyct68">
      <bpmn:text>Anamnese, klinische Untersuchung, Laboruntersuchungen, Allgemeinzustand, Röntgen Thorax, CT-Thorax</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vh8qs2">
      <bpmn:text>Ganzkörper-FDG-PET/CT oder Granzkörper MRT oder Volldiagnostisches CT des Thorax und Abdomen, ...

MRT oder CT des Hirnschädels</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z76f0w">
      <bpmn:text>Bronchoskopie oder Lungenbiospie

EBUS-TBNA und/oder EUS-FNA

ggf. Thorakozentese (Pleurapunktion)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_0nyed6o" categoryValueRef="CategoryValue_0urmzjs" />
    <bpmn:textAnnotation id="TextAnnotation_0q01uuw">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">medizinische Gründe lassen kein FDG-PET-Untersuchung zu: Ganzkörper-MRT oder Knochenszintigrafie mit CT Abdomen / Sonographie Abdomen</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>medizinische Gründe lassen kein FDG-PET-Untersuchung zu: Ganzkörper-MRT oder Knochenszintigrafie mit CT Abdomen / Sonographie Abdomen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_1h3w4bk" categoryValueRef="CategoryValue_0wtljum" />
    <bpmn:textAnnotation id="TextAnnotation_0026lez">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">Voraussetzung: CT-Untersuchung der Thoraxorgane</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>Voraussetzung: CT-Untersuchung der Thoraxorgane</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sijzbt">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">bei zentralem Tumor: mit verschiedene Methoden der Probeentnahme (S3-Leitlinie v5.1: Empf. 6.15 (A))

bei peripheren Raumforderungen: Kombination verschiedener Techniken (Bürste, Nadel, Katheter, Zange) (S3-Leitlinie v5.1: S. 129)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>bei zentralem Tumor: mit verschiedene Methoden der Probeentnahme (S3-Leitlinie v5.1: Empf. 6.15 (A))

bei peripheren Raumforderungen: Kombination verschiedener Techniken (Bürste, Nadel, Katheter, Zange) (S3-Leitlinie v5.1: S. 129)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1x37fzl">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">bei peripheren Raumforderungen: Kombination verschiedener Techniken (Bürste, Nadel, Katheter, Zange) (S3-Leitlinie v5.1: S. 129)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>bei peripheren Raumforderungen: Kombination verschiedener Techniken (Bürste, Nadel, Katheter, Zange) (S3-Leitlinie v5.1: S. 129)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02jpn32">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">ggf. unter radiologischer Kontrolle, Ultraschall-gesteuert oder CT-gesteuert ggf. mit mit Navigationsverfahren</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>ggf. unter radiologischer Kontrolle, Ultraschall-gesteuert oder CT-gesteuert ggf. mit mit Navigationsverfahren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_155h0bs">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">ggf. unter radiologischer Kontrolle oder CT-gesteuert ggf. mit mit Navigationsverfahren</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>ggf. unter radiologischer Kontrolle oder CT-gesteuert ggf. mit mit Navigationsverfahren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0nk32na">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="de">pathologische Beurteilung  der regionären Lymphknoten (S3-Leitlinie v5.1: Empf. 6.49)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>pathologische Beurteilung  der regionären Lymphknoten (S3-Leitlinie v5.1: Empf. 6.49)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vu3yk0">
      <bpmn:text>neuroendokriner Lungentumor: geeignetes Marker-Panel entsprechend der WHO-Klassifikation; Proliferationsfraktion des Tumorgewebes (Ki67, MiB1)

nicht-kleinzelliges Lungenkarzinom: empfohlene Marker entsprechend der WHO-Klassifikation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0v2ww2n">
      <bpmn:text>Mediastinoskopie (Position 2R, 2L, 4R, 4L und 7)
oder VATS oder anderes geeignetes chirurgisches Verfahren</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00qlo0z">
      <bpmn:text>oder parallel zu den Untersuchungen?
oder zum Teil auch schon pTNM?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1uhqyxk">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (Empf. 6.37).</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>Rundherd-Management (Größen-/Zeitschwellen, CT-Verlaufskontrollen) nach S3-LL Kap. 6.4 gilt formal für inzidentelle Rundherde (außerhalb der Früherkennung; Schwellen i. A. an British Thoracic Society 2015). Klar malignitätsverdächtige Befunde (symptomatisch bzw. ≥ 8 mm / hohes Risiko) gehen direkt in die pathologische Sicherung/Überweisung (Empf. 6.37).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qkhxne">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">Keine tumorgerichtete Abklärung:  weiterhin symptomatische/supportive Versorgung beim Hausarzt (EK 6.31)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>Keine tumorgerichtete Abklärung:  weiterhin symptomatische/supportive Versorgung beim Hausarzt (EK 6.31)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0e6lg4x">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">Voraufnahmen-Vergleich (Empf. 6.28) und Malignitäts-Wahrscheinlichkeit (Empf. 6.29/6.30)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>Voraufnahmen-Vergleich (Empf. 6.28) und Malignitäts-Wahrscheinlichkeit (Empf. 6.29/6.30)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qlv8ad">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">CT nur bei Verdacht und absehbarer Therapieoption (EK 6.4)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>CT nur bei Verdacht und absehbarer Therapieoption (EK 6.4)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1o4lb3n">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">Raucher-/Berufs-/ Familienanamnese, ECOG (EK 6.1)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>Raucher-/Berufs-/ Familienanamnese, ECOG (EK 6.1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0da80wq">
      <bpmn:extensionElements>
        <i18n:translation target="@text" lang="en">BB, Elektrolyte, Leber/Niere, Gerinnung, Schilddrüsenwerte: THS, Nierenwerte GFR/KREA (6.2)</i18n:translation>
      </bpmn:extensionElements>
      <bpmn:text>BB, Elektrolyte, Leber/Niere, Gerinnung, Schilddrüsenwerte: THS, Nierenwerte GFR/KREA (6.2)</bpmn:text>
    </bpmn:textAnnotation>
