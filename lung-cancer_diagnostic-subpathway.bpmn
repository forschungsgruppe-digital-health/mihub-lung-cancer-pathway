      <bpmn2:extensionElements>
        <i18n:translation target="@text" lang="de">als Mindestanforderung EGFR-Mutationen in den Exonen 18-21, BRAF V600 Mutationen, ALK-Fusionen, ROS1-Fusionen, RET-Fusionen, NTRK 1-3-Fusionen, KRAS-Mutationen (insbesondere KRAS-G12C-Mutation), MET-Exon 14-Skipping-Mutationen, NRG1-Fusionen und HER2 (ERBB 2)-Mutationen in den Exonen 8, 18, 19, 20 und 21</i18n:translation>
      </bpmn2:extensionElements>
